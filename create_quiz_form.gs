function createQuizForm() {
  validateQuestions_();

  const form = FormApp.create(CONFIG.title);
  form.setDescription(CONFIG.description)
    .setIsQuiz(true)
    .setShuffleQuestions(false)
    .setProgressBar(true)
    .setAllowResponseEdits(false)
    .setConfirmationMessage('ส่งคำตอบเรียบร้อย กด "ดูคะแนน" เพื่อดูคะแนนและเฉลย');
  if (CONFIG.limitOneResponsePerUser) {
    form.setLimitOneResponsePerUser(true);
  }

  // ข้อมูลผู้เรียน
  form.addTextItem().setTitle('ชื่อ-สกุล').setRequired(true);
  const idItem = form.addTextItem().setTitle('รหัสนักศึกษา').setRequired(true);
  if (CONFIG.studentIdPattern) {
    idItem.setValidation(
      FormApp.createTextValidation()
        .requireTextMatchesPattern(CONFIG.studentIdPattern)
        .setHelpText('กรุณากรอกรหัสนักศึกษาเป็นตัวเลข')
        .build()
    );
  }

  form.addPageBreakItem().setTitle('แบบทดสอบ 30 ข้อ');

  QUESTIONS.forEach(function (item, i) {
    const correct = LETTERS.indexOf(item.answer);
    const mc = form.addMultipleChoiceItem();
    mc.setTitle((i + 1) + '. ' + item.q)
      .setChoices(item.choices.map(function (text, j) {
        return mc.createChoice(LETTERS[j] + '. ' + text, j === correct);
      }))
      .setPoints(CONFIG.pointsPerQuestion)
      .setRequired(true);
  });

  Logger.log('ลิงก์สำหรับแก้ไขฟอร์ม: ' + form.getEditUrl());
  Logger.log('ลิงก์สำหรับส่งนักศึกษา: ' + form.getPublishedUrl());
}

function validateQuestions_() {
  QUESTIONS.forEach(function (item, i) {
    if (item.choices.length !== LETTERS.length) {
      throw new Error('ข้อ ' + (i + 1) + ': ต้องมี 5 ตัวเลือก');
    }
    if (LETTERS.indexOf(item.answer) < 0) {
      throw new Error('ข้อ ' + (i + 1) + ': answer ต้องเป็น ก ข ค ง หรือ จ');
    }
  });
}
